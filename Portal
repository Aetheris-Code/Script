local function wipeAllPortals()
    for _, p in ipairs(activePortals) do
        if p and p.Parent then p:Destroy() end
    end
    table.clear(activePortals)
    for _, p in ipairs(CollectionService:GetTagged(PORTAL_TAG)) do
        if p then p:Destroy() end
    end
    if voidPlatform and voidPlatform.Parent then
        voidPlatform:Destroy()
        voidPlatform = nil
    end
end

