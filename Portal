-- ติดเสียงไว้กับกล้อง = ได้ยินเต็มๆ ไม่ว่าจะซูมแค่ไหน
local function createMusicOnCamera(startPos)
    -- ลบอันเก่าออกก่อน
    if musicSound then
        musicPosition = musicSound.TimePosition
        musicSound:Stop()
        musicSound:Destroy()
        musicSound = nil
    end

    local snd          = Instance.new("Sound")
    snd.SoundId        = "rbxassetid://95895699912526"
    snd.Volume         = 1
    snd.Looped         = true
    snd.TimePosition   = startPos or 0
    snd.Parent         = camera   -- ← ติดกล้อง ได้ยินเสมอ
    snd:Play()
    musicSound = snd
end

local function stopMusic()
    if musicSound then
        musicPosition = musicSound.TimePosition
        musicSound:Stop()
        musicSound:Destroy()
        musicSound = nil
    end
end

