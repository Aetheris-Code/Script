MainSection:Button({
    Name     = "Server Hop (Walk In)",
    Callback = function()
        if isHopping then
            isHopping = false
            wipeAllPortals()
            return
        end

        isHopping = true

        task.spawn(function()
            local url = "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Desc&excludeFullGames=true&limit=100"
            local req = request or http_request or (syn and syn.request)

            if not req then
                isHopping = false
                Window:Notify({ Title = "Apex Hub", Description = "HTTP Blocked!", Lifetime = 3 })
                return
            end

            local response     = req({ Url = url, Method = "GET" })
            local targetServer = nil

            if response and response.Body then
                local ok, data = pcall(HttpService.JSONDecode, HttpService, response.Body)
                if ok and data and data.data then
                    for _, srv in ipairs(data.data) do
                        if srv.playing < srv.maxPlayers and srv.id ~= game.JobId then
                            targetServer = srv.id
                            break
                        end
                    end
                end
            end

            if not targetServer then
                isHopping = false
                Window:Notify({ Title = "Apex Hub", Description = "No server found!", Lifetime = 3 })
                return
            end

            local char = player.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            if not root then isHopping = false; return end

            wipeAllPortals()
            local hopPortal = createPortalInstance(root.CFrame * CFrame.new(0, 0, -5))
            Window:Notify({ Title = "Apex Hub", Description = "Walk into the portal!", Lifetime = 4 })

            local touched = false
            hopPortal.Touched:Connect(function(hit)
                if touched or not isHopping then return end
                if hit.Parent ~= player.Character then return end
                touched = true
                playTeleportVoice()
                Window:Notify({ Title = "Apex Hub", Description = "Hopping server...", Lifetime = 3 })

                if SCRIPT_URL ~= "" then
                    pcall(function()
                        queue_on_tp('loadstring(game:HttpGet("' .. SCRIPT_URL .. '"))()')
                    end)
                end
                TeleportService:TeleportToPlaceInstance(game.PlaceId, targetServer, player)
            end)
        end)
    end,
})

