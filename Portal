-- ── Mobile Touch Portal Gun ───────────────────────────────────────────────────
local touchConn = UserInputService.TouchTapInWorld:Connect(function(position, gameProcessed)
    if gameProcessed then return end
    if not portalGunActive then return end
    if isSpawning then return end

    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    -- Raycast จาก Touch position ลงไปใน World
    local unitRay = camera:ScreenPointToRay(position.X, position.Y)
    local rayParams = RaycastParams.new()
    rayParams.FilterDescendantsInstances = { char, unpack(activePortals) }
    rayParams.FilterType = Enum.RaycastFilterType.Exclude

    local rayResult = workspace:Raycast(unitRay.Origin, unitRay.Direction * 1000, rayParams)

    local hitPos  = nil
    local hitPart = nil

    if rayResult then
        hitPos  = rayResult.Position
        hitPart = rayResult.Instance
    end

    if not hitPos then return end

    isSpawning = true
    wipeAllPortals()

    if not hitPart then
        airWalkOn           = true
        platform.CanCollide = true

        voidPlatform              = Instance.new("Part")
        voidPlatform.Name         = "VoidBaseplate"
        voidPlatform.Size         = Vector3.new(60, 1, 60)
        voidPlatform.Position     = hitPos
        voidPlatform.Anchored     = true
        voidPlatform.Transparency = 1
        voidPlatform.CanCollide   = true
        voidPlatform.Parent       = workspace
        platformY                 = hitPos.Y
    end

    local exitPortal     = createPortalInstance(CFrame.lookAt(hitPos + Vector3.new(0, 3.5, 0), root.Position))
    local entrancePortal = createPortalInstance(root.CFrame * CFrame.new(0, 0, -5))

    entrancePortal.Touched:Connect(function(hit)
        if isTeleporting or hit.Parent ~= char then return end
        isTeleporting = true
        task.spawn(function()
            smartJumpToCFrame(root, exitPortal.CFrame * CFrame.new(0, 0, -6))
            task.wait(TELEPORT_COOLDOWN)
            isTeleporting = false
        end)
    end)

    exitPortal.Touched:Connect(function(hit)
        if isTeleporting or hit.Parent ~= char then return end
        isTeleporting = true
        task.spawn(function()
            smartJumpToCFrame(root, entrancePortal.CFrame * CFrame.new(0, 0, -6))
            task.wait(TELEPORT_COOLDOWN)
            isTeleporting = false
        end)
    end)

    task.wait(0.35)
    isSpawning = false
end)
table.insert(connections, touchConn)



