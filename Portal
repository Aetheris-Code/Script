local function fullCleanup()
    wipeAllPortals()
    if platform then platform:Destroy() end
    stopMusic()
    for _, c in ipairs(connections) do c:Disconnect() end
    table.clear(connections)
end

getgenv().RickPortalCleanup = fullCleanup
