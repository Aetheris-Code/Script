SettingSection:Colorpicker({
    Name    = "Select Color",
    Default = Color3.fromRGB(255, 255, 0),
    Alpha   = 0,
    Callback = function(color, alpha)
        local closest, bestDist = 1, math.huge
        for i, c in ipairs(colors) do
            local dr   = color.R - c.Color.R
            local dg   = color.G - c.Color.G
            local db   = color.B - c.Color.B
            local dist = dr*dr + dg*dg + db*db
            if dist < bestDist then
                bestDist = dist
                closest  = i
            end
        end
        currentColorIndex = closest
    end,
}, "ColorPicker")

