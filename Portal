local function getPlayerNames()
    local names = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player then
            table.insert(names, p.DisplayName)
        end
    end
    return names
end

local selectedTargetName = nil

MainSection:Dropdown({
    Name     = "Select Player",
    Search   = true,
    Multi    = false,
    Required = false,
    Options  = getPlayerNames(),
    Default  = {},
    Callback = function(value)
        selectedTargetName = value
    end,
}, "Dropdown")

MainSection:Button({
    Name     = "TP to Player",
    Callback = function()
        if not selectedTargetName or selectedTargetName == "" then
            Window:Notify({ Title = "Apex Hub", Description = "Select a player first!", Lifetime = 3 })
            return
        end

        local targetPlayer = nil
        for _, p in ipairs(Players:GetPlayers()) do
            if p.DisplayName == selectedTargetName or p.Name == selectedTargetName then
                targetPlayer = p
                break
            end
        end

        if not targetPlayer then
            Window:Notify({ Title = "Apex Hub", Description = "Player not found!", Lifetime = 3 })
            return
        end

        local char = player.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if not root then return end

        wipeAllPortals()
        local tpPortal = createPortalInstance(root.CFrame * CFrame.new(0, 0, -5))
        Window:Notify({ Title = "Apex Hub", Description = "Walk into the portal!", Lifetime = 4 })

        local touched = false
        tpPortal.Touched:Connect(function(hit)
            if touched or hit.Parent ~= char then return end
            touched = true
            playTeleportVoice()
            Window:Notify({ Title = "Apex Hub", Description = "Jumping dimensions...", Lifetime = 3 })

            task.spawn(function()
                local tChar = targetPlayer.Character
                if not tChar then
                    Window:Notify({ Title = "Apex Hub", Description = "Target doesn't exist!", Lifetime = 3 })
                    return
                end

                local tRoot = tChar:FindFirstChild("HumanoidRootPart") or tChar.PrimaryPart
                if tRoot then
                    root.CFrame = tRoot.CFrame * CFrame.new(0, 0, -4)
                else
                    local pivot   = tChar:GetPivot()
                    root.CFrame   = pivot * CFrame.new(0, 5, 0)
                    root.Anchored = true
                    pcall(function() player:RequestStreamAroundAsync(pivot.Position) end)
                    local t = tick() + 5
                    while tick() < t do
                        tRoot = tChar:FindFirstChild("HumanoidRootPart") or tChar.PrimaryPart
                        if tRoot then break end
                        task.wait(0.05)
                    end
                    if tRoot then
                        root.CFrame = tRoot.CFrame * CFrame.new(0, 0, -4)
                    end
                    root.Anchored = false
                end
            end)

            task.wait(1)
            wipeAllPortals()
        end)
    end,
})

